{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animeatlas.dev/schemas/media-identity.json",
  "title": "AnimeAtlas Media Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "provider_refs", "relationships"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "enum": ["media-identity/v1", "media-identity/v2"] },
    "id": { "type": "string", "pattern": "^media-[0-9]{6}$" },
    "kind": { "const": "anime" },
    "series_id": { "type": "string", "pattern": "^series-[0-9]{6}$" },
    "title": { "type": "string", "minLength": 1 },
    "installment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "season": { "type": "integer", "minimum": 1 },
        "part": { "type": "integer", "minimum": 1 },
        "cour": { "type": "integer", "minimum": 1 }
      }
    },
    "provider_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerRef" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema": { "const": "media-identity/v2" } } },
      "then": { "required": ["series_id", "title", "installment"] }
    }
  ],
  "$defs": {
    "providerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "entity", "id"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "entity": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "target": { "type": "string", "pattern": "^media-[0-9]{6}$" }
      }
    }
  }
}
