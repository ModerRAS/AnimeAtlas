{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animeatlas.dev/schemas/contribution.json",
  "title": "AnimeAtlas Approved Contribution",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "author"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "author": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "issue", "operation", "review"],
      "properties": {
        "schema": { "const": "contribution/v1" },
        "issue": { "$ref": "#/$defs/issue" },
        "operation": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["create_media", "add_alias", "add_provider_ref", "correct_metadata", "merge_media", "split_media"] }
          }
        },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "issue", "observation", "target", "changes", "review"],
      "properties": {
        "schema": { "const": "contribution/v2" },
        "issue": { "$ref": "#/$defs/issue" },
        "observation": { "type": "object", "additionalProperties": true, "required": ["parsed_installment"] },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["series_id", "media_id", "title", "installment", "provider_ref"],
          "properties": {
            "series_id": { "type": "string", "pattern": "^series-[0-9]{6}$" },
            "media_id": { "type": "string", "pattern": "^media-[0-9]{6}$" },
            "title": { "type": "string", "minLength": 1 },
            "installment": { "type": "object", "additionalProperties": false, "properties": {
              "season": { "type": "integer", "minimum": 1 },
              "part": { "type": "integer", "minimum": 1 },
              "cour": { "type": "integer", "minimum": 1 }
            } },
            "provider_ref": { "type": "object", "additionalProperties": false, "required": ["provider", "entity", "id"], "properties": {
              "provider": { "const": "bangumi" },
              "entity": { "const": "subject" },
              "id": { "type": "string", "pattern": "^[0-9]+$" }
            } }
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["type", "media_id"],
            "properties": {
              "type": { "enum": ["add_media_alias", "upsert_episode_numbers", "correct_metadata"] },
              "media_id": { "type": "string", "pattern": "^media-[0-9]{6}$" }
            }
          }
        },
        "review": { "$ref": "#/$defs/review" }
      }
    }
  }
}
